    {
      "id": "concl__text",
      "type": "text",
      "x": 437.7999999999996,
      "y": 1210,
      "width": 934.4000000000008,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
